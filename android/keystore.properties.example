# Optional. Without this file, release builds use ~/.android/dirian-release.jks (alias "dirian") and read its
# password from the macOS Keychain item "Dirian Android keystore". To use another key, copy this to
# keystore.properties (untracked), fill it in, and use an absolute path for storeFile.
storeFile=/Users/YOU/.android/dirian-release.jks
storePassword=
keyAlias=dirian
keyPassword=
